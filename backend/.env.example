# ---------------------------------------------------------------------------
# AEGIS-X Backend — Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# App
APP_NAME=AEGIS-X
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Security / JWT
SECRET_KEY=CHANGE_ME_use_a_64_char_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL) — full schema arrives in Module 3
DATABASE_URL=postgresql+asyncpg://aegis_user:aegis_pass@localhost:5432/aegis_x
DATABASE_URL_SYNC=postgresql+psycopg2://aegis_user:aegis_pass@localhost:5432/aegis_x

# CORS — the Lovable-built frontend origin(s). Comma-separated, no trailing slash.
# Add your Lovable preview URL and production custom domain here.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.lovable.app

# Logging
LOG_LEVEL=INFO
